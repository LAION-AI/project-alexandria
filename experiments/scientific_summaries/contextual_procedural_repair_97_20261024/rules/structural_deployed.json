    {
      "id": "v3_01",
      "pattern": "\\b(was|were|is|are) used to (?=(?:assess|analyze|analyse|apply|calculate|characterize|classify|compare|compute|construct|cross-validate|define|determine|estimate|evaluate|examine|explain|express|identify|illustrate|infer|investigate|map|measure|model|monitor|obtain|optimize|parameterize|predict|reduce|represent|sample|solve|test|track|train|validate|verify|visualize|describe|discuss|discriminate|derive|detect|estimate|fit|form|generate|interpret|introduce|resolve|show|study|transform|understand|use|write)\\b)",
      "flags": [
        "IGNORECASE"
      ],
      "replacement": "\\1 employed to ",
      "required_context_regex": null,
      "precondition": "Immediately followed by an infinitive from the approved verb list encoded in the pattern. Reject \u201cbe used to\u201d + noun/gerund (habituation) and retain the infinitive exactly.",
      "blocked_context_regex": [
        "(?i)\"[^\"\\n]*\"|`[^`]*`|\u201c[^\u201d\\n]*\u201d",
        "(?i)\\b(?:is not|are not|was not|were not|does not|do not|did not|cannot|may|might|could|would|should|must)\\b"
      ],
      "blocked_context_scope": "matched phrase plus at most three tokens on either side",
      "preserve_invariants": [
        "Preserve all numeric strings, dates, percentages, ranges, units, inequalities, and mathematical operators byte-for-byte across the full sentence.",
        "Preserve negation and modal auxiliaries byte-for-byte across the full sentence.",
        "Preserve all acronyms, proper names, citations, identifiers, formulas, and scientific object terms outside the exact matched phrase.",
        "Reject if any sentence-wide invariant differs after replacement."
      ],
      "confidence": "medium",
      "risk_note": "Source example confirms the original frame occurs in training; it does not establish replacement equivalence.",
